NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/task-management

JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Firebase Admin Configuration (From Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

EMAIL_SERVICE=smtp
EMAIL_FROM=noreply@taskflow.com
EMAIL_FROM_NAME=TaskFlow
ADMIN_EMAIL=admin@taskflow.com

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

GEMINI_API_KEY=your_gemini_api_key

